# Copier ce fichier en .env.local et renseigner les valeurs.
# En local : valeurs affichées par `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Clé secrète : UNIQUEMENT côté serveur (création des comptes par l'admin). Ne jamais l'exposer au navigateur.
SUPABASE_SECRET_KEY=sb_secret_xxx
# Fond de carte (facultatif). Par défaut : OpenStreetMap. Ex. https://api.maptiler.com/maps/streets/{z}/{x}/{y}.png?key=VOTRE_CLE
NEXT_PUBLIC_TUILES_URL=
# Rapport hebdomadaire par e-mail (tâche planifiée, voir vercel.json) :
# CRON_SECRET : chaîne aléatoire longue (Vercel l'envoie à la tâche) ; RESEND_API_KEY : clé du service d'e-mail Resend ;
# RAPPORT_EXPEDITEUR : ex. "Papel ERP <rapport@votre-domaine.gn>" (domaine vérifié chez Resend) ;
# NEXT_PUBLIC_SITE_URL : adresse publique de l'ERP (lien dans l'e-mail). Destinataires : paramètre « rapport_destinataires ».
CRON_SECRET=
RESEND_API_KEY=
RAPPORT_EXPEDITEUR=
NEXT_PUBLIC_SITE_URL=
