# ─── Application ─────────────────────────────────────────────────────────────
# URL publique du site (sans / final). En production : https://unyafrica.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Supabase ────────────────────────────────────────────────────────────────
# Dashboard Supabase > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clé publique : « publishable » (sb_publishable_…, recommandée) ou « anon » (ancienne clé JWT)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé secrète : « secret » (sb_secret_…, recommandée) ou « service_role ».
# Serveur uniquement, ne JAMAIS l'exposer côté client.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Emails transactionnels (bienvenue, validation/refus du justificatif) ─────
# N'importe quel SMTP : Resend, Brevo, Mailjet, SendGrid, Amazon SES…
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=
EMAIL_FROM="Uny <bonjour@unyafrica.com>"

# ─── Développement local uniquement ──────────────────────────────────────────
# Autorise next/image à optimiser les images servies par Supabase sur 127.0.0.1
# NEXT_IMAGE_ALLOW_LOCAL_IP=1

# ─── Vérification des étudiants ──────────────────────────────────────────────
# Clé HMAC (32 caractères min.) : les listes importées par les universités et les numéros de
# candidat au BAC ne sont stockés que sous forme d'empreintes. Ne jamais la changer après usage.
# Générer : openssl rand -hex 32
UNY_MATCH_SECRET=

# Clés API des universités raccordées (niveau 1) : une variable par université, nommée
# UNIV_<SIGLE>_API_KEY et référencée dans Admin → Universités → Connecteur API.
# UNIV_EXEMPLE_API_KEY=
