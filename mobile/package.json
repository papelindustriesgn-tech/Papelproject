{
  "name": "uny-mobile",
  "private": true,
  "version": "1.0.0",
  "description": "Applications Android et iOS d'Uny (Capacitor) — chargent le site en production.",
  "type": "module",
  "scripts": {
    "assets": "node scripts/gen-assets.mjs && capacitor-assets generate --android --ios --iconBackgroundColor '#5733f0' --iconBackgroundColorDark '#5733f0' --splashBackgroundColor '#5733f0' --splashBackgroundColorDark '#170c45'",
    "sync": "cap sync",
    "android": "cap open android",
    "ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.0.0",
    "typescript": "^5.9.0"
  }
}
