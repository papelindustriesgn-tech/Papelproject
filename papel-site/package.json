{
  "name": "papel-site",
  "version": "1.0.0",
  "private": true,
  "description": "Site officiel de Papel Industries",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "db:start": "supabase start -x edge-runtime,logflare,vector,imgproxy,studio",
    "db:reset": "supabase db reset",
    "admin:create": "node --env-file=.env.local scripts/create-admin.mjs",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.69.0",
    "next": "^16.3.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.91.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.7",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.122.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3"
  }
}
