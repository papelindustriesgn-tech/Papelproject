# --- Supabase (projet dédié Papel Industries, distinct de celui d'Uny) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé « service role » : serveur uniquement (formulaires, export). Ne jamais préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---
# URL publique canonique (sitemap, Open Graph, données structurées)
NEXT_PUBLIC_SITE_URL=https://www.papel-industries.com
# Sel utilisé pour anonymiser les adresses IP (limitation anti-spam des formulaires)
FORM_IP_SALT=change-moi-avec-une-valeur-aleatoire
# Nombre maximal d'envois par formulaire et par IP sur 30 minutes (défaut : 5)
# FORM_RATE_LIMIT_MAX=5

# Développement local uniquement (Supabase sur 127.0.0.1)
# NEXT_IMAGE_ALLOW_LOCAL_IP=1
